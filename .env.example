# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (PostgreSQL, e.g. Neon / Supabase / local) -------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hiresight?sslmode=require"

# --- Clerk authentication (https://dashboard.clerk.com) ----------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
# Route Clerk to the app's own sign-in/sign-up pages and land new users on onboarding.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/onboarding"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# --- Google Gemini (https://aistudio.google.com/app/apikey) ------------------
GEMINI_API_KEY="your-gemini-api-key"
# Optional overrides (defaults live in lib/gemini.js)
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-2.0-flash"

# --- Inngest (weekly insight refresh; only needed in production) ------------
# Local dev uses `npx inngest-cli@latest dev` and needs no keys.
# INNGEST_EVENT_KEY="your-inngest-event-key"
# INNGEST_SIGNING_KEY="your-inngest-signing-key"
